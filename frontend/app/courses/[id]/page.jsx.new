                )}
                
                {/* About Tab */}
                {activeTab === 'info' && (
                  <div>
                    <h3 className="text-lg font-semibold text-gray-900 dark:text-white mb-4">About This Course</h3>
                    
                    <div className="prose dark:prose-invert max-w-none mb-6">
                      <p>{course.description}</p>
                    </div>
                    
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                      <div>
                        <h4 className="text-md font-medium text-gray-900 dark:text-white mb-2">What You'll Learn</h4>
                        <ul className="space-y-2">
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Build modern, responsive websites with HTML, CSS, and JavaScript</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Create dynamic web applications with React</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Build RESTful APIs with Node.js and Express</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Work with databases like MongoDB</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Deploy your applications to the cloud</span>
                          </li>
                        </ul>
                      </div>
                      
                      <div>
                        <h4 className="text-md font-medium text-gray-900 dark:text-white mb-2">Requirements</h4>
                        <ul className="space-y-2">
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">Basic computer skills</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">No prior programming experience required</span>
                          </li>
                          <li className="flex items-start">
                            <FaCheck className="text-green-500 mt-1 mr-2 flex-shrink-0" />
                            <span className="text-gray-700 dark:text-gray-300">A computer with internet access</span>
                          </li>
                        </ul>
                      </div>
                    </div>
                    
                    <h3 className="text-lg font-semibold text-gray-900 dark:text-white mb-4">About the Instructor</h3>
                    <div className="flex items-center mb-6">
                      <div className="flex-shrink-0 h-16 w-16 rounded-full overflow-hidden bg-gray-200 dark:bg-gray-700">
                        <img 
                          src={course.instructor.avatar} 
                          alt={course.instructor.name}
                          className="h-full w-full object-cover"
                          onError={(e) => {
                            e.target.onerror = null;
                            e.target.src = "/fighterfish.png";
                          }}
                        />
                      </div>
                      <div className="ml-4">
                        <h4 className="text-md font-medium text-gray-900 dark:text-white">{course.instructor.name}</h4>
                        <p className="text-sm text-gray-600 dark:text-gray-400">{course.instructor.bio}</p>
                      </div>
                    </div>
                  </div>
                )}
                
                {/* Live Sessions Tab */}
                {activeTab === 'live-sessions' && (
                  <GoogleMeetIntegration 
                    courseId={courseId} 
                    isInstructor={false} 
                  />
                )}
                
                {/* Slack Tab */}
                {activeTab === 'slack' && (
                  <SlackIntegration 
                    courseId={courseId} 
                    isInstructor={false} 
                  />
                )}
              </div>
            </div>
          </div>
          
          {/* Right Column - Course Sidebar */}
          <div>
            {/* Course Info Card */}
            <div className="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden mb-6">
              <div className="relative h-48">
                <img 
                  src={course.thumbnail} 
                  alt={course.title} 
                  className="w-full h-full object-cover"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-4">
                  <div className="text-white">
                    <div className="flex items-center mb-1">
                      <FaStar className="text-yellow-500 mr-1" /> 
                      <span className="font-medium">{course.rating}</span>
                      <span className="mx-2">•</span>
                      <FaUsers className="mr-1" /> 
                      <span>{course.students} students</span>
                    </div>
                    <div className="text-2xl font-bold">${course.price}</div>
                  </div>
                </div>
              </div>
              
              <div className="p-4">
                <div className="grid grid-cols-2 gap-4 mb-4">
                  <div className="flex items-center">
                    <FaClock className="text-gray-500 dark:text-gray-400 mr-2" />
                    <div>
                      <div className="text-sm font-medium text-gray-900 dark:text-white">{getTotalDuration()}</div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">Total Duration</div>
                    </div>
                  </div>
                  <div className="flex items-center">
                    <FaBook className="text-gray-500 dark:text-gray-400 mr-2" />
                    <div>
                      <div className="text-sm font-medium text-gray-900 dark:text-white">{getTotalLessons()}</div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">Total Lessons</div>
                    </div>
                  </div>
                  <div className="flex items-center">
                    <FaGraduationCap className="text-gray-500 dark:text-gray-400 mr-2" />
                    <div>
                      <div className="text-sm font-medium text-gray-900 dark:text-white">{course.level}</div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">Level</div>
                    </div>
                  </div>
                  <div className="flex items-center">
                    <FaChalkboardTeacher className="text-gray-500 dark:text-gray-400 mr-2" />
                    <div>
                      <div className="text-sm font-medium text-gray-900 dark:text-white">{course.instructor.name}</div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">Instructor</div>
                    </div>
                  </div>
                </div>
                
                <button className="w-full py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                  Enroll Now
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
